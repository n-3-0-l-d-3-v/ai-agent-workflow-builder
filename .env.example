# nhost project (Settings -> General / Settings -> Environment Variables)
NHOST_SUBDOMAIN=
NHOST_REGION=
HASURA_GRAPHQL_ENDPOINT=https://<subdomain>.hasura.<region>.nhost.run/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=

# LLM provider for llm_call steps
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# used by functions to call back into Hasura
HASURA_GRAPHQL_URL=https://<subdomain>.hasura.<region>.nhost.run/v1/graphql

# frontend (web/.env.local)
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=
